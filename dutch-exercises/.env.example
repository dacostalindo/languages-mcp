# Search backend: auto picks the first configured one (brave > tavily > searxng > duckduckgo).
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
# Where the cache and ratings live (default ~/.dutch-exercises)
DATA_DIR=
# Extra/override sources, same JSON shape as dutch_exercises/data/sources.json
SOURCES_FILE=
# HTTP transport only
TRANSPORT=stdio
HOST=127.0.0.1
PORT=8010
MCP_TOKEN=
MCP_ALLOWED_HOSTS=
